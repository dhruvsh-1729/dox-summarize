# --- OpenRouter (multi-model AI: Claude, GPT, Grok, Gemini, Llama, …) ---
OPENROUTER_API_KEY=
# Optional attribution headers
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Dynamic Media Extractor

# --- PaddleOCR (default OCR — free, open-source, self-hosted) ---
# Local dev: http://localhost:8868. In docker-compose this is overridden to the
# internal service URL (http://paddle-ocr:8868), so you can leave this as-is.
PADDLE_OCR_URL=http://localhost:8868
# Default OCR language: en, hi (Hindi), sa (Sanskrit), ta, te, ka, arabic, …
PADDLE_OCR_LANG=en

# --- Reducto (premium OCR option) ---
REDUCTO_API_KEY=
REDUCTO_ENVIRONMENT=production

# --- Turso (source of truth for categories, fields, users, roles) ---
TURSO_DB_URL=
# Optional if your Turso DB requires an auth token
TURSO_AUTH_TOKEN=

# --- Auth (session signing secret — use a long random string, min 16 chars) ---
JWT_SECRET=
# Set to "true" ONLY to allow login over plain http:// (e.g. testing via IP).
# Leave unset/false when serving over HTTPS (recommended).
COOKIE_INSECURE=

# --- Seed script: first super-admin account ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Super Admin

# --- OpenRouter (multi-model AI: Claude, GPT, Grok, Gemini, Llama, …) ---
OPENROUTER_API_KEY=
# Optional attribution headers
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Dynamic Media Extractor

# --- PaddleOCR (default OCR — free, open-source, self-hosted) ---
# Start the service in paddle-ocr-service/ (docker compose up -d), then point here.
PADDLE_OCR_URL=http://localhost:8868
# Default OCR language: en, devanagari (Hindi), gujarati, ch, arabic, …
PADDLE_OCR_LANG=en

# --- Reducto (premium OCR option) ---
REDUCTO_API_KEY=
REDUCTO_ENVIRONMENT=production

# --- Turso (source of truth for categories, fields, users, roles) ---
TURSO_DB_URL=
# Optional if your Turso DB requires an auth token
TURSO_AUTH_TOKEN=

# --- Auth (session signing secret — use a long random string, min 16 chars) ---
JWT_SECRET=

# --- Seed script: first super-admin account ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Super Admin
